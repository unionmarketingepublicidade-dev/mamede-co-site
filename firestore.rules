rules_version = '2';service cloud.firestore {match /databases/{database}/documents {function isAdmin(){return request.auth != null && request.auth.uid == 'e8Nxn1euL6cowiQZfeRP242omXf1' && request.auth.token.email == 'contato.lucasmamede@proton.me' && request.auth.token.email_verified == true;}match /siteSettings/{id}{allow read:if id == "hero";allow write:if isAdmin();}match /portfolioSites/{id}{allow read:if true;allow write:if isAdmin();}match /portfolioVideos/{id}{allow read:if true;allow write:if isAdmin();}match /{document=**}{allow read,write:if false;}}}