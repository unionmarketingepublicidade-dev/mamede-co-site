rules_version = '2';service firebase.storage {match /b/{bucket}/o {function isAdmin(){return request.auth != null && request.auth.token.email == 'unionmarketingepublicidade@gmail.com' && request.auth.token.email_verified == true;}match /portfolio/{kind}/{file}{allow read:if true;allow create:if isAdmin() && ((kind == 'cover' && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')) || (kind == 'video' && request.resource.size < 100 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm)')));allow update,delete:if isAdmin();}}}